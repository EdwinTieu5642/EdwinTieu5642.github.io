---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { Image, getImage } from "astro:assets";
import edwinPhoto from "../assets/edwin.jpg";
import heroBackgroundSrc from "../assets/WebsiteBackground.jpg";
import { socials } from "../data/socials";
import { projects } from "../data/projects";
import { skillGroups } from "../data/skills";
import { experience } from "../data/experience";

const heroBackground = await getImage({
  src: heroBackgroundSrc,
  width: 1920,
  format: "webp",
});

const stats = [
  { value: "1", label: "iOS App Shipped" },
  { value: "3", label: "Research Projects" },
  { value: "3", label: "Internships Worked" },
  { value: "∞", label: "Curiosity" },
];

const externalLink = { target: "_blank", rel: "noopener noreferrer" };

// schema.org Person markup so search engines can show a rich result for a
// name search. `sameAs` links profiles that belong to the same person.
const portrait = await getImage({ src: edwinPhoto, width: 600, height: 600, format: "jpg" });
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Edwin Tieu",
  url: Astro.site?.href,
  image: new URL(portrait.src, Astro.site).href,
  jobTitle: "Embedded Software Engineer",
  worksFor: { "@type": "Organization", name: experience[0].company },
  alumniOf: { "@type": "CollegeOrUniversity", name: "University of Southern California" },
  sameAs: socials.filter((s) => s.external).map((s) => s.href),
};
---

<BaseLayout title="Edwin Tieu — Embedded Software Engineer">
  <Fragment slot="head">
    <!-- The hero image is a CSS background, which the browser only discovers
         after the stylesheet loads; preloading starts the download right away. -->
    <link rel="preload" as="image" type="image/webp" href={heroBackground.src} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <section class="hero" style={`--hero-bg-image: url(${heroBackground.src})`}>
    <div class="hero-content">
      <div class="availability-badge">
        <span class="availability-dot"></span>
        Open to New Projects and Collaborations
      </div>
      <h1>Edwin Tieu</h1>
      <p class="hero-subtitle">
        Embedded Software Engineer building resilient defense systems - <br />
        from Inertial Navigation Systems to Acoustic Localization Networks.
      </p>
      <div class="hero-links">
        {socials.map((s) => (
          <a href={s.href} class="hero-link" aria-label={s.label} {...(s.external ? externalLink : {})}>
            <Icon icon={s.icon} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section about" id="about">
    <h2 class="section-title">About Me</h2>
    <div class="intro">
      <Image src={edwinPhoto} alt="Edwin Tieu" class="intro-photo" width={600} height={600} />
      <div class="intro-text">
        <p>
          I'm an Embedded Software Engineer passionate about solving hard problems at the intersection of AI and Defense. I earned both my B.S. in Computer Science and Computer Engineering and my M.S. in Computer Engineering from USC.
        </p>
        <p>
          I'm driven by building systems that have real-world impact, especially technologies that can help protect and save lives. My goal is to continuously grow by taking on challenging problems and pushing myself to learn as quickly as possible.
        </p>
        <p>
          In my free time, I like to work on developing iOS Applications, learn more about Machine Learning and Artificial Intelligence systems, and ideate new and exciting projects to work on next.
        </p>
      </div>
    </div>
  </section>

  <section class="section stats">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-card">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="projects">
    <h2 class="section-title">Projects</h2>
    <p class="section-subtitle">Examples of my work in embedded systems and software engineering.</p>
    <div class="card-grid">
      {projects.map((p) => {
        const Card = p.href ? "a" : "div";
        return (
          <Card class="card card-hover project-card" {...(p.href ? { href: p.href, ...externalLink } : {})}>
            <div class="card-header">
              <Icon icon={p.icon} class="project-icon" size={p.iconSize} />
              <h3>{p.title}</h3>
            </div>
            <p>{p.description}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </Card>
        );
      })}
    </div>
  </section>

  <section class="section skills" id="skills">
    <h2 class="section-title">Skills</h2>
    <p class="section-subtitle">The technologies that I work with in my tech stack.</p>
    <div class="card-grid">
      {skillGroups.map((g) => (
        <div class="card skill-card">
          <div class="card-header">
            <Icon icon={g.icon} class="skill-icon" />
            <h3>{g.title}</h3>
          </div>
          <ul class="skill-list">
            {g.items.map((item) => (
              <li class="skill-item">
                <div class="skill-meta">
                  <span class="skill-name">{item.name}</span>
                  <span class="skill-pct">{item.level}%</span>
                </div>
                <div class="skill-bar-track">
                  <div class="skill-bar-fill" style={`--level: ${item.level}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="experience">
    <h2 class="section-title">Experience</h2>
    <p class="section-subtitle">Where I've worked and what I've built.</p>
    <div class="experience-list">
      {experience.map((job) => (
        <div class="card experience-item">
          <div class="experience-header">
            <div class="experience-meta">
              <h3 class="experience-role">{job.role}</h3>
              <span class="experience-company">{job.company}</span>
              <span class="experience-location">{job.period} · {job.location}</span>
            </div>
          </div>
          <p class="experience-desc">{job.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="blog">
    <h2 class="section-title">Blog</h2>
    <p class="section-subtitle">Thoughts on engineering, research, and building things.</p>
    <p class="blog-empty">No blogs yet...but will come soon!</p>
  </section>

  <section class="section find-me" id="contact">
    <h2>Contact</h2>
    <ul>
      {socials.map((s) => (
        <li><a href={s.href} {...(s.external ? externalLink : {})}>{s.label}</a></li>
      ))}
    </ul>
  </section>

<script>
  // Animate the skill bars from 0 the first time the section scrolls into view.
  // Without JS the bars render at full width (see `.js` rules in global.css).
  const skillsSection = document.querySelector('.skills');
  if (skillsSection) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    observer.observe(skillsSection);
  }
</script>
</BaseLayout>
