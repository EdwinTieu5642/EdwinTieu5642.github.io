---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { Image, getImage } from "astro:assets";
import edwinPhoto from "../assets/edwin.jpg";
import heroBackgroundSrc from "../assets/WebsiteBackground.jpg";
import { socials } from "../data/socials";
import { projects } from "../data/projects";
import { skillGroups } from "../data/skills";
import { experience } from "../data/experience";
import { icons, type IconDef } from "../data/icons";

const heroBackground = await getImage({
  src: heroBackgroundSrc,
  width: 1920,
  format: "webp",
});

// `icon` draws the value instead of typing it, for characters the display font
// doesn't include (∞); `value` is still read out to screen readers.
const stats: { value: string; label: string; icon?: IconDef }[] = [
  { value: "1", label: "iOS App Shipped" },
  { value: "3", label: "Research Projects" },
  { value: "3", label: "Internships Worked" },
  { value: "∞", label: "Curiosity", icon: icons.infinity },
];

const externalLink = { target: "_blank", rel: "noopener noreferrer" };
// Served as-is from public/; replace that file to update the résumé.
const resumeHref = "/EdwinTieuResume.pdf";
// "Aug 2026" -> "2026-08", for machine-readable <time> elements.
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const toDatetime = (label: string) => {
  const [month, year] = label.split(" ");
  const index = months.indexOf(month);
  return index >= 0 && year ? `${year}-${String(index + 1).padStart(2, "0")}` : undefined;
};

const email = socials.find((s) => s.href.startsWith("mailto:"))?.href.slice("mailto:".length);

// schema.org Person markup so search engines can show a rich result for a
// name search. `sameAs` links profiles that belong to the same person.
const portrait = await getImage({ src: edwinPhoto, width: 600, height: 600, format: "jpg" });
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Edwin Tieu",
  url: Astro.site?.href,
  image: new URL(portrait.src, Astro.site).href,
  jobTitle: "Embedded Software Engineer",
  worksFor: { "@type": "Organization", name: experience[0].company },
  alumniOf: { "@type": "CollegeOrUniversity", name: "University of Southern California" },
  sameAs: socials.filter((s) => s.external).map((s) => s.href),
};
---

<BaseLayout title="Edwin Tieu — Embedded Software Engineer">
  <Fragment slot="head">
    <!-- The hero image is a CSS background, which the browser only discovers
         after the stylesheet loads; preloading starts the download right away. -->
    <link rel="preload" as="image" type="image/webp" href={heroBackground.src} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <section class="hero" style={`--hero-bg-image: url(${heroBackground.src})`}>
    <div class="hero-content">
      <div class="availability-badge">
        <span class="availability-dot"></span>
        Open to New Projects and Collaborations
      </div>
      <h1>Edwin Tieu</h1>
      <p class="hero-subtitle">
        Embedded Software Engineer building resilient defense systems —
        from Inertial Navigation Systems to Acoustic Localization Networks.
      </p>
      <div class="hero-links">
        {socials.map((s) => (
          <a href={s.href} class="hero-link" aria-label={s.label} {...(s.external ? externalLink : {})}>
            <Icon icon={s.icon} />
          </a>
        ))}
      </div>
    </div>
    <a href="#about" class="hero-scroll" aria-label="Scroll to About">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </a>
  </section>

  <section class="section reveal about" id="about">
    <h2 class="section-title">About Me</h2>
    <div class="intro">
      <Image src={edwinPhoto} alt="Edwin Tieu" class="intro-photo" width={600} height={600} />
      <div class="intro-text">
        <p>
          I'm an Embedded Software Engineer passionate about solving hard problems at the intersection of AI and Defense. I earned both my B.S. in Computer Science and Computer Engineering and my M.S. in Computer Engineering from USC.
        </p>
        <p>
          I'm driven by building systems that have real-world impact, especially technologies that can help protect and save lives. My goal is to continuously grow by taking on challenging problems and pushing myself to learn as quickly as possible.
        </p>
        <p>
          In my free time, I like to work on developing iOS Applications, learn more about Machine Learning and Artificial Intelligence systems, and ideate new and exciting projects to work on next.
        </p>
      </div>
    </div>
  </section>

  <section class="section reveal stats">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-card">
          <span class="stat-value">
            {s.icon ? <><Icon icon={s.icon} class="stat-icon" /><span class="visually-hidden">{s.value}</span></> : s.value}
          </span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section reveal" id="projects">
    <h2 class="section-title">Projects</h2>
    <p class="section-subtitle">Examples of my work in embedded systems and software engineering.</p>
    <ul class="card-grid" role="list">
      {projects.map((p) => {
        const Card = p.href ? "a" : "div";
        return (
          <li>
            <Card class="card card-hover project-card" {...(p.href ? { href: p.href, ...externalLink } : {})}>
              <div class="card-header">
                <Icon icon={p.icon} class="project-icon" size={p.iconSize} />
                <h3>{p.title}</h3>
              </div>
              <p>{p.description}</p>
              <div class="project-tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </Card>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="section reveal skills" id="skills">
    <h2 class="section-title">Skills</h2>
    <p class="section-subtitle">The technologies that I work with in my tech stack.</p>
    <div class="card-grid">
      {skillGroups.map((g) => (
        <div class="card card-hover skill-card">
          <div class="card-header">
            <Icon icon={g.icon} class="skill-icon" />
            <h3>{g.title}</h3>
          </div>
          <ul class="skill-list">
            {g.items.map((item) => (
              <li class="skill-item">
                <div class="skill-meta">
                  <span class="skill-name">{item.name}</span>
                  <span class="skill-pct">{item.level}%</span>
                </div>
                <div class="skill-bar-track">
                  <div class="skill-bar-fill" style={`--level: ${item.level}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section reveal" id="experience">
    <h2 class="section-title">Experience</h2>
    <p class="section-subtitle">Where I've worked and what I've built.</p>
    <ol class="experience-list" role="list">
      {experience.map((job) => (
        <li class="card card-hover experience-item">
          <div class="experience-header">
            <div class="experience-meta">
              <h3 class="experience-role">{job.role}</h3>
              <span class="experience-company">{job.company}</span>
              <span class="experience-location">
                {job.period.split(" – ").map((part, i) => {
                  const datetime = toDatetime(part);
                  return <>{i > 0 && " – "}{datetime ? <time datetime={datetime}>{part}</time> : part}</>;
                })} · {job.location}
              </span>
            </div>
          </div>
          <p class="experience-desc">{job.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section reveal" id="resume">
    <h2 class="section-title">Résumé</h2>
    <p class="section-subtitle">A one-page summary of my education, experience, and skills.</p>
    <div class="resume-actions">
      <a href={resumeHref} class="resume-button resume-button-primary" download="Edwin-Tieu-Resume.pdf">
        <Icon icon={icons.download} />
        Download PDF
      </a>
      <a href={resumeHref} class="resume-button" {...externalLink}>
        <Icon icon={icons.fileText} />
        View in Browser
      </a>
    </div>
  </section>

  <section class="section reveal" id="blog">
    <h2 class="section-title">Blog</h2>
    <p class="section-subtitle">Thoughts on engineering, research, and building things.</p>
    <p class="blog-empty">No blogs yet...but will come soon!</p>
  </section>

  <section class="section reveal find-me" id="contact">
    <h2 class="section-title">Contact</h2>
    {email && (
      <>
        <p class="section-subtitle">The best way to reach me is by email.</p>
        <div class="contact-email">
          <a href={`mailto:${email}`}>{email}</a>
          <!-- Revealed by the script below when the Clipboard API is available. -->
          <button type="button" class="copy-email" data-email={email} aria-live="polite" hidden>Copy</button>
        </div>
      </>
    )}
    <ul>
      {socials.filter((s) => s.external).map((s) => (
        <li><a href={s.href} {...(s.external ? externalLink : {})}>{s.label}</a></li>
      ))}
    </ul>
  </section>

<script>
  // Mark each section `in-view` the first time it scrolls into view: sections
  // fade in and the skill bars grow from 0. Without JS everything renders
  // as-is (see the `.js` rules in global.css).
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal').forEach(section => revealObserver.observe(section));

  // Copy-to-clipboard for the email address in the Contact section.
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
  if (copyButton && navigator.clipboard) {
    copyButton.hidden = false;
    let resetTimer: number | undefined;
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.email ?? '');
        copyButton.textContent = 'Copied!';
      } catch {
        copyButton.textContent = 'Copy failed';
      }
      clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => { copyButton.textContent = 'Copy'; }, 2000);
    });
  }
</script>
</BaseLayout>
