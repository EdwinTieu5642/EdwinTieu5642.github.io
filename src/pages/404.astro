---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<!-- GitHub Pages serves dist/404.html for any path that doesn't exist. -->
<BaseLayout title="Page not found — Edwin Tieu" description="This page doesn't exist.">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <section class="section not-found">
    <p class="not-found-code">404</p>
    <h1 class="section-title">Page not found</h1>
    <p class="section-subtitle">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="not-found-home">Back to the homepage</a>
  </section>
</BaseLayout>
