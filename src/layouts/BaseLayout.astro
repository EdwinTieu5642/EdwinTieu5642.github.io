---
import "../styles/global.css";
import { getImage } from "astro:assets";
import edwinPhoto from "../assets/edwin.jpg";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Edwin Tieu is an embedded software engineer building resilient defense systems, from inertial navigation systems to acoustic localization networks.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({ src: edwinPhoto, width: 600, height: 600, format: "jpg" });
const socialImageUrl = new URL(socialImage.src, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#090817" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Edwin Tieu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Portrait of Edwin Tieu" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <!-- Lets CSS tell JS-enabled visitors apart (used by the skill bar animation). -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-title">Edwin</a>
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <svg class="icon-hamburger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <nav class="site-nav">
        <a href="/#about">About</a>
        <a href="/#projects">Projects</a>
        <a href="/#skills">Skills</a>
        <a href="/#experience">Experience</a>
        <a href="/#blog">Blog</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Edwin Tieu</p>
    </footer>
  </body>
</html>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const nav = document.querySelector('.site-nav') as HTMLElement;

  toggle.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  nav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });
</script>
